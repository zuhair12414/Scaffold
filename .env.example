# baseline (default) talks to Ollama; scaffold uses the mocked ladder
VITE_TUTOR_MODE=baseline
VITE_OLLAMA_MODEL=qwen2.5-coder:1.5b
# VITE_UI=full shows mastery bars, tests, compiler explanations, struggle nudge, retrieval and profile selectors
VITE_UI=lite
# which system prompt the lite view uses, since its selector is hidden: plain | basic | hardened
VITE_PROMPT=plain
# comma-separated models to hide from the Model dropdown
VITE_HIDE_MODELS=
# student model: static (fixed mastery) | bkt (updates after each run)
VITE_STUDENT_MODEL=static
