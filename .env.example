# scaffold (default) is the product tutor: mocked ladder, guardrail, no model needed.
# baseline talks to Ollama and is the unguarded control condition. The tutor header
# switches between them at runtime, so this only picks what the app opens on.
VITE_TUTOR_MODE=baseline
VITE_OLLAMA_MODEL=qwen2.5-coder:7b
# VITE_UI=full shows mastery bars, tests, compiler explanations, struggle nudge, retrieval and profile selectors
VITE_UI=lite
# which system prompt the lite view uses, since its selector is hidden: plain | basic | hardened
VITE_PROMPT=plain
